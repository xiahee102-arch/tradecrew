{
  "name": "tradecrew",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0",
    "build": "vite build && node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "local": "node scripts/local.mjs",
    "configure": "node scripts/local.mjs --configure-only",
    "codespaces:setup": "node scripts/codespaces.mjs setup",
    "codespaces:start": "node scripts/codespaces.mjs start",
    "test:ui": "esbuild tests/strategy-render.jsx --bundle --platform=node --format=cjs --external:react --external:react-dom/server --outfile=work/strategy-render-check.cjs && node work/strategy-render-check.cjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.9.0",
    "xlsx": "^0.18.5",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "vite": "^6.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "wrangler": "^4.0.0",
    "miniflare": "5.20261104.0-beta",
    "undici": "7.30.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
